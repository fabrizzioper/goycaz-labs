# Token del usuario del sistema del Business Portfolio de GoyCaz Labs.
# NO uses el token temporal del Graph API Explorer: caduta en 1-2 horas.
META_ACCESS_TOKEN=

# Version de la Graph API. Si `doctor` avisa que caduco, sube el numero.
META_GRAPH_API_VERSION=v26.0

# Todos estos IDs los descubre y te los imprime `npm run ads discover`.
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_ID=

# Numero de WhatsApp al que llegan los clics, formato internacional sin +.
META_WHATSAPP_NUMBER=51981369224

# Opcionales: si los pones, `doctor` puede leer los permisos exactos del token.
META_APP_ID=
META_APP_SECRET=
