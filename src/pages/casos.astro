---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import Marks from '../components/Marks.astro';
import { url } from '../lib/site';
import { cases, showcase } from '../lib/content';
import ShowcaseMock from '../components/ShowcaseMock.astro';
---
<Layout
  active="/casos"
  title="Casos — GoyCaz Labs"
  titleEn="Work — GoyCaz Labs"
  description="Sitios y sistemas en produccion que puedes abrir ahora mismo, mas casos de IA sobre datos, kioscos con facturacion e infraestructura con 99.9% de uptime.">

  <section class="page-hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="aurora" data-aurora data-speed="0.4" data-blend="0.6" data-amplitude="1"></div>
      <div class="fade"></div>
    </div>
    <div class="wrap hero-inner stagger">
      <p class="label" data-en="Our work">Nuestro trabajo</p>
      <h1><span data-en="Work in production, not ">Trabajo en producción, no </span><span class="ac" data-en="slideware">diapositivas</span><span data-en=".">.</span></h1>
      <p class="lead" data-en="Sites you can open right now, plus the systems behind them. Real projects with real users, real data and real load.">Sitios que puedes abrir ahora mismo, y los sistemas que hay detrás. Proyectos reales con usuarios, datos y carga reales.</p>
    </div>
  </section>

  <!-- Sitios en produccion: visitables -->
  <section class="section no-line" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="label" data-en="Live sites">Sitios en vivo</p>
        <h2 data-en="Open them. They are in production right now.">Ábrelos. Están en producción ahora mismo.</h2>
      </div>
      <div class="site-grid stagger">
        {showcase.map((s, i) => (
          <a class="site-card" href={s.href} target="_blank" rel="noopener">
            <div class="site-shot">
              {s.image
                ? <img src={url(s.image)} alt={s.name} width="960" height="600" loading={i < 2 ? "eager" : "lazy"} decoding="async" />
                : <div class={`ph ${s.placeholder}`}><ShowcaseMock type={s.mock} /></div>}
            </div>
            <div class="site-body">
              <span class="badge" data-en={s.industryEn}>{s.industryEs}</span>
              <h3>{s.name}</h3>
              <p data-en={s.descEn}>{s.descEs}</p>
              {s.stack && <div class="site-stack">{s.stack.map((t) => <span>{t}</span>)}</div>}
              <span class="site-link" data-en="Visit the site">Visitar el sitio</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Casos con detalle tecnico -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="label" data-en="Case studies">Casos a detalle</p>
        <h2 data-en="Systems behind the scenes.">Sistemas que no se ven, pero sostienen el negocio.</h2>
        <p class="lead" data-en="Under NDA we cannot show screens, so here is the problem, what we did and the outcome.">Por acuerdos de confidencialidad no podemos mostrar pantallas, así que va el problema, qué hicimos y el resultado.</p>
      </div>
      {cases.map((c) => (
        <div class="marks reveal">
          <Marks />
          <article class="study">
            <div class="study-head">
              <span class="badge" data-en={c.tagEn}>{c.tagEs}</span>
              <h3 data-en={c.en}>{c.es}</h3>
            </div>
            <div class="study-body">
              <div class="col"><div class="k" data-en="Problem">Problema</div><p data-en={c.problemEn}>{c.problemEs}</p></div>
              <div class="col"><div class="k" data-en="What we did">Qué hicimos</div><p data-en={c.approachEn}>{c.approachEs}</p></div>
              <div class="col"><div class="k" data-en="Result">Resultado</div><p data-en={c.resultEn}>{c.resultEs}</p></div>
            </div>
            <div class="study-metrics">
              {c.metrics.map((m) => (
                <div><b data-en={m.big}>{m.big}</b><span data-en={m.capEn}>{m.capEs}</span></div>
              ))}
            </div>
          </article>
        </div>
      ))}
    </div>
  </section>

  <CtaBand />
</Layout>
