---
import Layout from '../layouts/Layout.astro';
import Marks from '../components/Marks.astro';
import { WHATSAPP, WHATSAPP_PRETTY, EMAIL, INSTAGRAM, INSTAGRAM_URL } from '../lib/site';
import { icons } from '../lib/icons';
---
<Layout
  active="/contacto"
  title="Contacto — GoyCaz Labs"
  titleEn="Contact — GoyCaz Labs"
  description="Cuéntanos qué te está frenando. Una llamada de 20 minutos, sin costo y sin compromiso.">

  <section class="page-hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="aurora" data-aurora data-speed="0.4" data-blend="0.6" data-amplitude="1"></div>
      <div class="fade"></div>
    </div>
    <div class="wrap hero-inner stagger">
      <span class="pill"><span class="dot ping"></span><span data-en="Available for new projects">Disponibles para nuevos proyectos</span></span>
      <h1><span data-en="Tell us what's ">Cuéntanos qué te está </span><span class="ac" data-en="slowing you down">frenando</span><span data-en=".">.</span></h1>
      <p class="lead" data-en="A 20-minute call, no cost and no commitment. We'll tell you straight if AI or software gives you a real return — and how we'd do it.">Una llamada de 20 minutos, sin costo y sin compromiso. Te decimos con franqueza si la IA o el software te dan un retorno real — y cómo lo haríamos.</p>
    </div>
  </section>

  <section class="section no-line" style="padding-top:0">
    <div class="wrap contact">
      <div class="stagger">
        <p class="label" data-en="Contact">Contacto</p>
        <h2 class="h2"><span data-en="Reach us however you ">Escríbenos por donde </span><span class="ac" data-en="like">prefieras</span><span data-en=".">.</span></h2>
        <p class="lead muted" style="margin-top:16px;font-size:16px;line-height:1.625" data-en="The fastest way is WhatsApp — fill the form and it opens with your message ready. Prefer email or a call? All good.">Lo más rápido es WhatsApp — llena el formulario y se abre con tu mensaje listo. ¿Prefieres correo o una llamada? También.</p>
        <div class="contact-list">
          <a href={`https://wa.me/${WHATSAPP}?text=${encodeURIComponent('Hola GoyCaz Labs, quiero saber más')}`} target="_blank" rel="noopener noreferrer">
            <span class="ico sm" set:html={icons.whatsapp}></span>
            <span>WhatsApp · {WHATSAPP_PRETTY}</span>
            <span set:html={icons.arrowUpRight.replace('<svg', '<svg class="arr"')}></span>
          </a>
          <a href={`mailto:${EMAIL}`}>
            <span class="ico sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>
            <span>{EMAIL}</span>
            <span set:html={icons.arrowUpRight.replace('<svg', '<svg class="arr"')}></span>
          </a>
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
            <span class="ico sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/></svg></span>
            <span>@{INSTAGRAM}</span>
            <span set:html={icons.arrowUpRight.replace('<svg', '<svg class="arr"')}></span>
          </a>
        </div>
      </div>

      <div class="marks reveal">
        <Marks />
        <form class="form" id="contactForm">
          <div class="row">
            <div class="field"><label for="f_name" data-en="Name">Nombre</label><input id="f_name" required autocomplete="name" placeholder="Ej. María Torres" /></div>
            <div class="field"><label for="f_biz" data-en="Business">Negocio</label><input id="f_biz" autocomplete="organization" placeholder="Ej. Restaurante Sol" /></div>
          </div>
          <div class="field"><label for="f_need" data-en="What do you need?">¿Qué necesitas?</label>
            <select id="f_need">
              <option data-en="AI agent on WhatsApp">Agente de IA por WhatsApp</option>
              <option data-en="Website or app">Web o app</option>
              <option data-en="Automate a process">Automatizar un proceso</option>
              <option data-en="AI over my data">IA sobre mis datos</option>
              <option data-en="Modernize a system">Modernizar un sistema</option>
              <option data-en="Not sure yet — need advice">Aún no sé — quiero que me orienten</option>
            </select>
          </div>
          <div class="field"><label for="f_msg" data-en="Tell us a bit more">Cuéntanos un poco más</label><textarea id="f_msg" placeholder="¿Qué parte de tu día a día te quita más tiempo o te hace perder ventas?"></textarea></div>
          <button type="submit" class="btn btn-primary btn-lg btn-block">
            <span set:html={icons.whatsapp}></span>
            <span data-en="Send via WhatsApp">Enviar por WhatsApp</span>
            <span set:html={icons.arrowUpRight}></span>
          </button>
          <p class="form-note" data-en="Opens WhatsApp with your message ready to send.">Abre WhatsApp con tu mensaje listo para enviar.</p>
        </form>
      </div>
    </div>
  </section>
</Layout>
