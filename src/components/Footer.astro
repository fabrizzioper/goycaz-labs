---
import { url, EMAIL, WHATSAPP, INSTAGRAM_URL, LINKEDIN_URL } from '../lib/site';
---
<footer class="site-footer">
  <div class="wrap foot-wrap">
    <div class="marks">
      <div class="mk" aria-hidden="true">
        <svg viewBox="0 0 12 12"><line x1="6" y1="0" x2="6" y2="12" stroke="currentColor" stroke-width="1"/><line x1="0" y1="6" x2="12" y2="6" stroke="currentColor" stroke-width="1"/></svg>
        <svg viewBox="0 0 12 12"><line x1="6" y1="0" x2="6" y2="12" stroke="currentColor" stroke-width="1"/><line x1="0" y1="6" x2="12" y2="6" stroke="currentColor" stroke-width="1"/></svg>
        <svg viewBox="0 0 12 12"><line x1="6" y1="0" x2="6" y2="12" stroke="currentColor" stroke-width="1"/><line x1="0" y1="6" x2="12" y2="6" stroke="currentColor" stroke-width="1"/></svg>
        <svg viewBox="0 0 12 12"><line x1="6" y1="0" x2="6" y2="12" stroke="currentColor" stroke-width="1"/><line x1="0" y1="6" x2="12" y2="6" stroke="currentColor" stroke-width="1"/></svg>
      </div>
      <div class="foot-box">
        <div class="foot-brand">
          <a href={url('/')} class="logo" aria-label="GoyCaz Labs">
            <img src={url('/logo.png')} alt="GoyCaz Labs" class="logo-light" width="150" height="40" />
        <img src={url('/logo-dark.png')} alt="" class="logo-dark" width="150" height="40" aria-hidden="true" />
          </a>
          <p data-en="AI, software and infrastructure that actually ship to production — without breaking what works, no lock-in.">IA, software e infraestructura que sí llegan a producción — sin romper lo que funciona, sin lock-in.</p>
          <div class="foot-social">
            <a href={`https://wa.me/${WHATSAPP}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.2-.2-1.2-1.5-1.2-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.6c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.4 2.6 1.6.3.1.5.1.6-.1l.7-.9c.2-.2.4-.2.6-.1l1.8.9c.3.1.5.2.5.4.1.2.1.7-.1 1.5Z"/></svg>
            </a>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/></svg>
            </a>
            <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.7c0-1.36-.03-3.1-1.94-3.1-1.94 0-2.24 1.47-2.24 2.99V21h-4z"/></svg>
            </a>
            <a href={`mailto:${EMAIL}`} aria-label="Email">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </a>
          </div>
        </div>
        <div class="foot-cols">
          <div class="foot-col">
            <h4 data-en="Services">Servicios</h4>
            <ul>
              <li><a href={url('/servicios')} data-en="AI agents">Agentes de IA</a></li>
              <li><a href={url('/servicios')} data-en="AI over your data">IA sobre tus datos</a></li>
              <li><a href={url('/servicios')} data-en="Web &amp; mobile apps">Web y apps móviles</a></li>
              <li><a href={url('/servicios')} data-en="Infrastructure &amp; DevOps">Infraestructura y DevOps</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h4 data-en="Company">Empresa</h4>
            <ul>
              <li><a href={url('/casos')} data-en="Work">Casos</a></li>
              <li><a href={url('/precios')} data-en="Pricing">Precios</a></li>
              <li><a href={url('/nosotros')} data-en="About">Nosotros</a></li>
              <li><a href={url('/#faq')} data-en="FAQ">Preguntas frecuentes</a></li>
            </ul>
          </div>
          <div class="foot-col">
            <h4 data-en="Contact">Contacto</h4>
            <ul>
              <li><a href={`https://wa.me/${WHATSAPP}`} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
              <li><a href={`mailto:${EMAIL}`}>Email</a></li>
              <li><a href={url('/contacto')} data-en="Book a call">Agenda una llamada</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <p>© <span id="yr">2026</span> GoyCaz Labs — Perú</p>
      <div class="links">
        <a href={url('/nosotros')} data-en="About">Nosotros</a>
        <a href={url('/contacto')} data-en="Contact">Contacto</a>
        <a href={url('/privacidad')} data-en="Privacy">Privacidad</a>
        <a href={url('/terminos')} data-en="Terms">Términos</a>
        <a href={url('/eliminacion-datos')} data-en="Data deletion">Eliminación de datos</a>
      </div>
    </div>
  </div>
</footer>
