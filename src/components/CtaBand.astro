---
import { url, WHATSAPP } from '../lib/site';
import { icons } from '../lib/icons';
const wa = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent('Hola GoyCaz Labs, quiero una propuesta')}`;
---
<section class="cta" id="contacto">
  <div class="gridbg" aria-hidden="true"></div>
  <div class="orb" aria-hidden="true"></div>
  <div class="line" aria-hidden="true"></div>
  <div class="cta-inner stagger">
    <span class="pill"><span class="dot ping"></span><span data-en="Available for new projects">Disponibles para nuevos proyectos</span></span>
    <h2><span data-en="Let's make your business run ">Hagamos que tu negocio funcione </span><span class="ac" data-en="on its own">solo</span><span data-en=".">.</span></h2>
    <p class="lead" data-en="Tell us what you need. We send you a concrete proposal — timeline, scope and price — in under 24 hours.">Cuéntanos qué necesitas. Te enviamos una propuesta concreta — con tiempo, alcance y precio — en menos de 24 horas.</p>
    <div class="btns">
      <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
        <span set:html={icons.whatsapp}></span>
        <span data-en="Get a quote on WhatsApp">Cotizar por WhatsApp</span>
        <span set:html={icons.arrowUpRight}></span>
      </a>
      <a href={url('/casos')} class="btn btn-ghost btn-lg" data-en="See client work">Ver casos de clientes</a>
    </div>
    <p class="note" data-en="We reply in under 1 business hour">Respondemos en menos de 1 hora hábil</p>
  </div>
</section>
