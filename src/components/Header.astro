---
import { url, NAV, WHATSAPP } from '../lib/site';
import { services } from '../lib/content';
const { active = '' } = Astro.props;
const arrow = '<svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
const wa = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent('Hola GoyCaz Labs, quiero cotizar un proyecto')}`;
---
<header class="site-header" id="siteHeader">
  <div class="nav-inner">
    <div class="nav-start">
      <a href={url('/')} class="logo" aria-label="GoyCaz Labs — Inicio">
        <img src={url('/logo.png')} alt="GoyCaz Labs" class="logo-light" width="150" height="40" />
        <img src={url('/logo-dark.png')} alt="" class="logo-dark" width="150" height="40" aria-hidden="true" />
      </a>
    </div>

    <div class="nav-center">
      <nav class="nav-links" aria-label="Principal">
        {NAV.map((item) => (
          <a href={url(item.href)} class={active === item.href ? 'active' : ''} data-en={item.en}>{item.es}</a>
        ))}
      </nav>
    </div>

    <div class="nav-end">
      <div class="lang" role="group" aria-label="Idioma / Language">
        <button type="button" class="active" data-lang="es">ES</button>
        <button type="button" data-lang="en">EN</button>
      </div>
      <button type="button" class="icon-btn theme-btn" id="themeBtn" aria-label="Cambiar tema">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2m-7.07-15.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
      <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm nav-cta" data-en="Get a quote">Cotizar</a>
      <button type="button" class="burger" id="menuBtn" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileMenu">
        <i aria-hidden="true"><span></span><span></span></i>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Menú principal">
  <div class="mobile-menu-inner">
    <div class="mobile-menu-body">
      <section class="mm-section">
        <p class="label" data-en="Services">Servicios</p>
        <div class="mm-box">
          <ul>
            {services.slice(0, 4).map((s) => (
              <li>
                <a href={url('/servicios')}>
                  <span class="ico sm" set:html={s.icon}></span>
                  <span class="txt"><span data-en={s.en}>{s.es}</span><small data-en={s.bulletsEn[0]}>{s.bulletsEs[0]}</small></span>
                  <span set:html={arrow}></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
      <section class="mm-section">
        <p class="label" data-en="Explore">Explora</p>
        <div class="mm-box">
          <ul>
            {NAV.map((item) => (
              <li><a href={url(item.href)}><span data-en={item.en}>{item.es}</span><span set:html={arrow}></span></a></li>
            ))}
          </ul>
        </div>
      </section>
      <div class="mm-foot">
        <div class="row">
          <span class="label" data-en="Language">Idioma</span>
          <div class="lang" role="group" aria-label="Idioma / Language">
            <button type="button" class="active" data-lang="es">ES</button>
            <button type="button" data-lang="en">EN</button>
          </div>
        </div>
        <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg btn-block">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.2-.2-1.2-1.5-1.2-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.6c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.4 2.6 1.6.3.1.5.1.6-.1l.7-.9c.2-.2.4-.2.6-.1l1.8.9c.3.1.5.2.5.4.1.2.1.7-.1 1.5Z"/></svg>
          <span data-en="Get a quote on WhatsApp">Cotizar por WhatsApp</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
        </a>
      </div>
    </div>
  </div>
</div>
