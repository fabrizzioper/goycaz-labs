---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url, WHATSAPP } from '../lib/site';

const {
  title = 'GoyCaz Labs — IA, software e infraestructura que sí llegan a producción',
  description = 'Construimos agentes de IA, software, apps e infraestructura para empresas — en producción, sin romper lo que funciona y sin lock-in.',
  active = '',
  titleEn = 'GoyCaz Labs — AI, software & infrastructure that actually ship to production',
} = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#F3F6FA" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0B1220" media="(prefers-color-scheme: dark)" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="es_PE" />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="preload" href={url('/fonts/geist-latin.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={url('/fonts/playfair-italic-latin.woff2')} as="font" type="font/woff2" crossorigin />
  <script is:inline>
    (function () {
      var el = document.documentElement;
      el.classList.add('js');
      var t = 'light';
      try {
        var q = new URLSearchParams(location.search).get('theme');
        t = (q === 'dark' || q === 'light') ? q : (localStorage.getItem('goycaz-theme') || 'light');
      } catch (e) {}
      el.setAttribute('data-theme', t === 'dark' ? 'dark' : 'light');
    })();
  </script>
  <script is:inline defer src={url('/aurora.js')}></script>
</head>
<body>
  <Header active={active} />
  <main>
    <slot />
  </main>
  <Footer />

  <script is:inline define:vars={{ WHATSAPP, titleEn }}>
    (function () {
      // ── idioma ES/EN ──────────────────────────────────────────────
      var STORE = 'goycaz-lang';
      var els = document.querySelectorAll('[data-en]');
      els.forEach(function (el) { el.dataset.es = el.innerHTML; });
      var titleEs = document.title;
      function apply(lang) {
        var en = lang === 'en';
        els.forEach(function (el) { el.innerHTML = en ? el.dataset.en : el.dataset.es; });
        document.documentElement.lang = en ? 'en' : 'es';
        document.title = en ? titleEn : titleEs;
        document.querySelectorAll('[data-lang]').forEach(function (b) {
          b.classList.toggle('active', b.getAttribute('data-lang') === lang);
        });
        try { localStorage.setItem(STORE, lang); } catch (e) {}
        window.__lang = lang;
      }
      var saved = 'es';
      try { saved = localStorage.getItem(STORE) || 'es'; } catch (e) {}
      apply(saved);
      document.querySelectorAll('[data-lang]').forEach(function (b) {
        b.addEventListener('click', function () { apply(b.getAttribute('data-lang')); });
      });

      // ── tema ──────────────────────────────────────────────────────
      var themeBtn = document.getElementById('themeBtn');
      if (themeBtn) themeBtn.addEventListener('click', function () {
        var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('goycaz-theme', next); } catch (e) {}
      });

      // ── header: píldora flotante al hacer scroll (>16px) ──────────
      var header = document.getElementById('siteHeader');
      function onScroll() { if (header) header.classList.toggle('stuck', window.scrollY > 16); }
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // ── menú móvil ────────────────────────────────────────────────
      var mb = document.getElementById('menuBtn'), mm = document.getElementById('mobileMenu');
      function setMenu(open) {
        if (!header || !mm || !mb) return;
        header.classList.toggle('open', open);
        mm.classList.toggle('open', open);
        document.body.classList.toggle('locked', open);
        mb.setAttribute('aria-expanded', open ? 'true' : 'false');
        mb.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      }
      if (mb && mm) {
        mb.addEventListener('click', function () { setMenu(!mm.classList.contains('open')); });
        mm.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { setMenu(false); }); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setMenu(false); });
        window.addEventListener('resize', function () { if (window.innerWidth >= 768) setMenu(false); });
      }

      // ── año ───────────────────────────────────────────────────────
      var yr = document.getElementById('yr');
      if (yr) yr.textContent = new Date().getFullYear();

      // ── formulario de contacto → WhatsApp ─────────────────────────
      var form = document.getElementById('contactForm');
      if (form) {
        form.addEventListener('submit', function (ev) {
          ev.preventDefault();
          var g = function (id) { var n = document.getElementById(id); return n ? (n.value || '').trim() : ''; };
          var name = g('f_name'), biz = g('f_biz'), need = g('f_need'), msg = g('f_msg');
          var en = window.__lang === 'en';
          var t = en
            ? ("Hi GoyCaz Labs! I'm " + name + (biz ? (' from ' + biz) : '') + '. I’m interested in: ' + need + '.' + (msg ? (' ' + msg) : ''))
            : ('¡Hola GoyCaz Labs! Soy ' + name + (biz ? (' de ' + biz) : '') + '. Me interesa: ' + need + '.' + (msg ? (' ' + msg) : ''));
          window.open('https://wa.me/' + WHATSAPP + '?text=' + encodeURIComponent(t), '_blank');
        });
      }
    })();
  </script>
  <script>import '../scripts/reveal.ts';</script>
</body>
</html>
